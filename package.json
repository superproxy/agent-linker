{
  "name": "linkagent-gw",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAI 兼容网关：Chatbox/Open WebUI → Gateway → ACP(acpx) → opencode",
  "packageManager": "pnpm@8.6.5",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "config:init": "node scripts/config-init.mjs",
    "setup:pi": "node scripts/setup-pi.mjs",
    "setup:channels": "node scripts/setup-channels.mjs",
    "dev": "pnpm --filter @linkagent/backend dev",
    "migrate:repo": "node scripts/migrate-repo-layout.mjs",
    "migrate:copy": "node scripts/migrate-copy-install.mjs",
    "migrate:server": "bash scripts/migrate-server-from-legacy.sh",
    "local:install-update": "node scripts/local-install-update.mjs",
    "start": "pnpm --filter @linkagent/backend start",
    "probe": "pnpm --filter @linkagent/backend probe",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @linkagent/backend test",
    "bot:weixin": "pnpm --filter @linkagent/backend bot:weixin",
    "bot:wecom": "pnpm --filter @linkagent/backend bot:wecom",
    "web": "pnpm --filter @linkagent/web dev",
    "build:web": "pnpm --filter @linkagent/web build",
    "image:code-server": "docker build -t linkagent-code-server:local -f code-server/Dockerfile code-server",
    "image:node": "bash scripts/build-node.sh",
    "build:dist": "node scripts/build-dist.mjs",
    "build:dist:node": "node scripts/build-dist.mjs --target=node",
    "server": "bash scripts/server.sh start",
    "server:start": "bash scripts/server.sh start",
    "server:stop": "bash scripts/server.sh stop",
    "server:restart": "bash scripts/server.sh restart",
    "server:status": "bash scripts/server.sh status",
    "server:log": "bash scripts/server.sh log",
    "server:install-update": "bash scripts/server-install-update.sh",
    "server:update": "bash scripts/server-install-update.sh",
    "edge": "bash scripts/edge.sh start",
    "edge:start": "bash scripts/edge.sh start",
    "edge:stop": "bash scripts/edge.sh stop",
    "edge:restart": "bash scripts/edge.sh restart",
    "edge:status": "bash scripts/edge.sh status",
    "edge:log": "bash scripts/edge.sh log",
    "edge:build": "bash scripts/edge.sh build",
    "server:dev": "bash scripts/server.sh foreground",
    "node": "node scripts/node-ctl.mjs start",
    "node:help": "node scripts/node-ctl.mjs --help",
    "node:start": "node scripts/node-ctl.mjs start",
    "node:stop": "node scripts/node-ctl.mjs stop",
    "node:restart": "node scripts/node-ctl.mjs restart",
    "node:status": "node scripts/node-ctl.mjs status",
    "node:log": "node scripts/node-ctl.mjs log",
    "node:dev": "node scripts/node-ctl.mjs foreground",
    "node:docker": "node code-server/node-docker/ctl.mjs start",
    "node:docker:build": "node code-server/node-docker/ctl.mjs build",
    "node:docker:stop": "node code-server/node-docker/ctl.mjs stop",
    "node:docker:restart": "node code-server/node-docker/ctl.mjs restart",
    "node:docker:status": "node code-server/node-docker/ctl.mjs status",
    "node:docker:log": "node code-server/node-docker/ctl.mjs log",
    "dev:all": "bash scripts/dev-all.sh",
    "pm": "pnpm --filter @linkagent/backend pm",
    "start:all": "pnpm --filter @linkagent/backend pm:start",
    "stop:all": "pnpm --filter @linkagent/backend pm:stop",
    "restart:all": "pnpm --filter @linkagent/backend pm:restart",
    "status:all": "pnpm --filter @linkagent/backend pm:status",
    "logs:all": "pnpm --filter @linkagent/backend pm:logs",
    "foreground": "pnpm --filter @linkagent/backend pm:fg"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "openclaw": "workspace:*"
    }
  }
}
