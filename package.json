{
  "name": "linkagent-gw",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAI 兼容网关：Chatbox/Open WebUI → Gateway → ACP(acpx) → opencode",
  "packageManager": "pnpm@8.6.5",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "config:init": "node scripts/ops-config-init.mjs",
    "setup:pi": "node scripts/ops-setup-pi.mjs",
    "setup:channels": "node scripts/ops-setup-channels.mjs",
    "dev": "pnpm --filter @linkagent/backend dev",
    "migrate:config": "node scripts/migrate-config.mjs",
    "migrate:install-config": "node scripts/migrate-install-config.mjs",
    "migrate:repo": "node scripts/migrate-config.mjs",
    "migrate:copy": "node scripts/migrate-install-config.mjs",
    "migrate:server": "bash scripts/migrate-server-from-legacy.sh",
    "local:install-update": "node scripts/deploy-local-install-update.mjs",
    "start": "pnpm --filter @linkagent/backend start",
    "probe": "pnpm --filter @linkagent/backend probe",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @linkagent/backend test",
    "bot:weixin": "pnpm --filter @linkagent/backend bot:weixin",
    "bot:wecom": "pnpm --filter @linkagent/backend bot:wecom",
    "web": "pnpm --filter @linkagent/web dev",
    "build:web": "pnpm --filter @linkagent/web build",
    "image:code-server": "docker build -t linkagent-code-server:local -f code-server/Dockerfile code-server",
    "image:node": "bash scripts/build-node.sh",
    "build:dist": "node scripts/build-dist.mjs",
    "build:dist:node": "node scripts/build-dist.mjs --target=node",
    "server": "node scripts/dev-server-ctl.mjs start",
    "server:start": "node scripts/dev-server-ctl.mjs start",
    "server:stop": "node scripts/dev-server-ctl.mjs stop",
    "server:restart": "node scripts/dev-server-ctl.mjs restart",
    "server:status": "node scripts/dev-server-ctl.mjs status",
    "server:log": "node scripts/dev-server-ctl.mjs log",
    "server:install-update": "bash scripts/deploy-server-install-update.sh",
    "server:update": "bash scripts/deploy-server-install-update.sh",
    "edge": "node scripts/edge-ctl.mjs start",
    "edge:start": "node scripts/edge-ctl.mjs start",
    "edge:stop": "node scripts/edge-ctl.mjs stop",
    "edge:restart": "node scripts/edge-ctl.mjs restart",
    "edge:status": "node scripts/edge-ctl.mjs status",
    "edge:log": "node scripts/edge-ctl.mjs log",
    "edge:build": "node scripts/edge-ctl.mjs build",
    "local:stack": "node scripts/dev-local-stack-ctl.mjs start",
    "local:stack:start": "node scripts/dev-local-stack-ctl.mjs start",
    "local:stack:stop": "node scripts/dev-local-stack-ctl.mjs stop",
    "local:stack:restart": "node scripts/dev-local-stack-ctl.mjs restart",
    "local:stack:status": "node scripts/dev-local-stack-ctl.mjs status",
    "local:stack:verify": "node scripts/dev-verify-stack.mjs",
    "local:stack:start:enhance": "node scripts/dev-local-stack-ctl.mjs start:enhance",
    "local:stack:start:enhance:docker": "node scripts/dev-local-stack-ctl.mjs start:enhance:docker",
    "local:stack:restart:enhance": "node scripts/dev-local-stack-ctl.mjs restart:enhance",
    "local:stack:restart:enhance:docker": "node scripts/dev-local-stack-ctl.mjs restart:enhance:docker",
    "task:links": "node scripts/dev-print-task-links.mjs",
    "server:dev": "node scripts/dev-server-ctl.mjs foreground",
    "node": "node scripts/dev-node-ctl.mjs start",
    "node:help": "node scripts/dev-node-ctl.mjs --help",
    "node:start": "node scripts/dev-node-ctl.mjs start",
    "node:stop": "node scripts/dev-node-ctl.mjs stop",
    "node:restart": "node scripts/dev-node-ctl.mjs restart",
    "node:status": "node scripts/dev-node-ctl.mjs status",
    "node:log": "node scripts/dev-node-ctl.mjs log",
    "node:dev": "node scripts/dev-node-ctl.mjs foreground",
    "node:docker": "node code-server/node-docker/ctl.mjs start",
    "node:docker:build": "node code-server/node-docker/ctl.mjs build",
    "node:docker:stop": "node code-server/node-docker/ctl.mjs stop",
    "node:docker:restart": "node code-server/node-docker/ctl.mjs restart",
    "node:docker:status": "node code-server/node-docker/ctl.mjs status",
    "node:docker:log": "node code-server/node-docker/ctl.mjs log",
    "dev:all": "bash scripts/dev-all.sh",
    "pm": "pnpm --filter @linkagent/backend pm",
    "start:all": "pnpm --filter @linkagent/backend pm:start",
    "stop:all": "pnpm --filter @linkagent/backend pm:stop",
    "restart:all": "pnpm --filter @linkagent/backend pm:restart",
    "status:all": "pnpm --filter @linkagent/backend pm:status",
    "logs:all": "pnpm --filter @linkagent/backend pm:logs",
    "foreground": "pnpm --filter @linkagent/backend pm:fg"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "openclaw": "workspace:*"
    }
  }
}
