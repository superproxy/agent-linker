# 推荐：拆分为同目录下 gateway.yaml、weixin.yaml、node.yaml（各进程改各自文件）。
# 若同目录已存在 gateway.yaml，本文件会被忽略。
# 以下为旧版单文件示例（gateway/weixin/node 三段）；扁平旧格式仍会自动迁移。

gateway:
  server:
    host: 127.0.0.1
    port: 8787
  auth:
    mode: local
    token: ""
    sessionTtlDays: 7
  agents: []
  tasks:
    defaultAgentId: pi

weixin:
  enabled: true
  mode: weixin-bot
  model: agent:pi

node:
  enabled: true
  agents:
    - pi
