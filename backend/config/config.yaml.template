# linkagent 三进程共享配置（gateway / weixin / node 读同一文件）
# 旧的扁平格式（顶层 server/auth/...）仍被自动识别并迁移，无需手工改动。
#
# Agent 与任务路由（必读）：
#   任务绑定 (nodeId, agentId) 能否执行，取决于「该 nodeId 对应机器」在握手时自报的 agent 清单。
#   - nodeId=local：由网关进程按 gateway.agents 在本机拉起 ACP（/api/node-agents 的 local 分组）。
#   - nodeId=n_xxx：由该节点连接器自报 agents（config.node.agents 或独立节点的 LINKAGENT_NODE_AGENTS）；
#     网关只读注册表，不在远程机器上改开通情况。
#   因此：本机若要任务走「远程节点」或 pm 拉起的 node 进程，gateway.agents 与 node.agents 须同时包含
#   同一 agent id（gateway 侧是完整定义，node 侧是 id 列表）；仅写 gateway 不会出现在节点注册里。

# ── gateway 网关进程 ──────────────────────────────────────
gateway:
  server:
    host: 127.0.0.1
    port: 8787
  auth:
    # 鉴权模式：
    #   local（默认，本机）：回环请求免登录识别为「本机默认用户」；
    #                        他机/手机/API 必须携带永久 gateway token，否则 401。
    #   token：强制令牌，任何来源（含本机浏览器）都需 gateway token 或账号会话。
    #   open ：完全不鉴权（仅建议绑回环）。
    mode: local
    # gateway token（默认用户的永久凭据，三进程共享，不过期）：
    #   留空 → 首次启动自动生成并落盘 .runtime-state/gateway-token（权限 0600）；
    #   填写 → 以配置为准。Chatbox/远程节点/手机端用它作为 Bearer token。
    token: ""
    # 账号登录会话有效期（天），滑动续期；默认 7 天（token/local 模式下账号会话使用）
    sessionTtlDays: 7
  # gateway.agents：仅描述 nodeId=local（网关本机执行）的 agent 完整定义。
  # 远程机器各自在 node.agents / 环境变量里声明 id，与这里无关。
  # permissionMode 透传 ACP 权限模式（AcpWrapper 缺省 approve-reads + 非交互 deny = 只读问答）：
  #   approve-all   自动批准全部权限请求（写文件/终端命令直接放行）
  #   approve-reads 只读放行、写类操作需审批（headless 下审批一律拒绝）
  #   deny-all      全部拒绝
  # 注意：配置 agents 后以本列表为准，需要哪些 local agent 就列全；后台「添加并启用」会同步写入 node.agents。
  agents:
    - id: opencode
      type: opencode
      displayName: OpenCode
      description: 本地 opencode（经 ACP/acpx），全权限
      permissionMode: approve-all
    - id: pi
      type: pi
      displayName: Pi
      description: 本地 pi（pi-coding-agent，经 pi-acp ACP 桥接），全权限
      # 会话 model 省略则用 pi 默认。云机初始化：pnpm setup:pi（生成 ~/.pi/agent 模型清单）。
      # 不要把 volcengine/... 写进本字段；覆盖时须为本机 models.json 已有项，例如 my/doubao-seed-2-0-pro-260215
      permissionMode: approve-all
    - id: workbuddy
      type: workbuddy
      displayName: WorkBuddy
      description: CodeBuddy Code CLI（经 codebuddy --acp），全权限
      permissionMode: approve-all
    - id: trace-cli
      type: trace-cli
      displayName: TraeCode CLI
      description: TraeCode CLI（经 traecli acp serve），全权限
      permissionMode: approve-all
    - id: cursor
      type: cursor
      displayName: Cursor
      description: Cursor CLI（经 agent acp），全权限
      permissionMode: approve-all
    # 示例：Hermes（须本机已装 hermes acp；与 node.agents 中的 hermes 成对出现）
    - id: hermes
      type: hermes
      displayName: Hermes
      description: Hermes Agent（hermes acp），全权限
      permissionMode: approve-all
  # agent 默认工作目录：未显式配 cwd 的 agent 在此目录下运行（缺省回退网关启动目录）
  # defaultCwd: /Users/yangxuezeng/linkagent/works

  # ── openclaw 渠道插件（可选）────────────────────────────
  # 企业微信：channels.<id> 配 botId/secret 即启用（默认内置 @wecom/wecom-openclaw-plugin）
  # 个人微信：配置 plugins 后先扫码登录（pnpm --filter @linkagent/backend weixin-login），
  #           登录态存 .runtime-state/plugins/openclaw-weixin/，重启自动收消息
  # 注意：package 以 @ 开头必须加引号（yaml 保留字符）
  plugins:
    - package: "@tencent-weixin/openclaw-weixin"

  # openclaw-weixin 插件渠道配置（weixin.mode=openclaw-weixin-plugin 时透传给插件路由；weixin-bot 模式下自动跳过该插件）
  channels:
    openclaw-weixin:
      agentId: pi # 个人微信默认对话 agent（对齐 weixin-bot 模式的 weixin.model）

  # ── 任务公共能力（多渠道共享）────────────────────────────
  # tasks.defaultAgentId：任务全空时的路由兜底（内建默认任务固定本机 pi，不受此项改写）
  # tasks.workspaceDir：任务工作空间根目录（缺省 .runtime-state/tasks-workspace）。
  #   配置后每个任务默认拥有独立工作目录 <root>/<userId>/<taskId>，任务间文件系统隔离；
  #   显式 /task cwd 设置的目录优先。
  tasks:
    defaultAgentId: pi

# ── weixin 个人微信进程 ───────────────────────────────────
# 进程管理器（pm start all）按 enabled 决定是否拉起；gatewayUrl/gatewayToken
# 缺省由 gateway 段自动推导；supervisor 托管时 LINKAGENT_GATEWAY_URL/TOKEN 被
# 显式置空屏蔽（只认本配置段），独立启动 weixin-bot 仍可用环境变量覆盖。
weixin:
  enabled: true
  # weixin-bot：gateway 进程内拉起（默认，单跑 gateway 时）
  # openclaw-weixin-plugin：openclaw 插件运行时
  # external：独立进程（进程管理器托管时经环境变量自动切换，一般无需手填）
  mode: weixin-bot
  # accountId: ""            # 登录态账号 id（缺省取 accounts/ 下第一个）
  # accounts: []             # 多账号白名单：external（进程管理器托管）时每个账号一个独立 bot 进程，
  #                          # 实例 id weixin:<accountId>（pid/日志/登录态相互隔离）；
  #                          # 留空 = 单实例（跑 accountId 或 accounts/ 下第一个账号）
  model: agent:pi # 对话模型（默认 agent:pi）
  # gatewayUrl: ""           # 缺省由 gateway.server 推导（0.0.0.0/:: 归一化到 127.0.0.1）
  # gatewayToken: ""         # 缺省取 gateway.auth.token 或自动生成的 gateway-token 文件

# ── node 执行器进程（连接器）──────────────────────────────
# pm start node 拉起的本机节点：agents 只认本段（LINKAGENT_NODE_AGENTS 被 supervisor 置空）。
# 独立节点包仍可用环境变量 LINKAGENT_NODE_AGENTS 覆盖。
# 列表须与本机已安装 CLI 一致；任务路由到 n_xxx 时只认此处（及握手）注册的 id。
# permissionMode / permissionPolicy 不在本段配置：连接器从同文件 gateway.agents 按 id 合并，hello 时上报给网关。
node:
  enabled: true
  # name: ""                # 节点展示名（缺省 node-<hostname>）
  agents:
    - opencode
    - pi
    - workbuddy
    - trace-cli
    - cursor
    - hermes
  # gatewayUrl: ""          # 缺省由 gateway.server 推导
  # gatewayToken: ""        # 缺省取 gateway.auth.token 或 gateway-token 文件
