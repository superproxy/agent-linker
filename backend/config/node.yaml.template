# node 连接器（pm start node / 独立节点包）；supervisor 拉起时不读 LINKAGENT_NODE_AGENTS
# ACP permissionMode / permissionPolicy 只在此文件，hello 上报、turn 下发
enabled: true
agents:
  - opencode
  - pi
  - workbuddy
  - trace-cli
  - id: cursor
    permissionMode: approve-all
    # key: <Cursor API key>   # 启动：agent acp --key <key>（也可写 command: [agent, acp, --key, ...]）
  - hermes

# 切换任务时在该任务目录拉起，命令只写在节点上。网关只下发 taskId 与 cwd。
# 缺省不拉起。聚合容器设 LINKAGENT_DEV_BY_NODE=1 时，未写这里就用 npm run dev。
# code-server 与 VNC 仍由容器入口常驻，不要在这里再写同一条命令。
# taskProcesses:
#   - id: dev
#     command: [npm, run, dev, --, --host, 0.0.0.0, --port, 5173, --strictPort]

# 默认 false（原生 frpc）；浏览器 IDE 用 pnpm local:stack:enhance 或 enabled: true + pnpm image:code-server。
# 桌面 VS Code/Cursor 直接打开 workspace，不经过此开关。
# PM 原生 node 是否在宿主机 docker compose 独立 code-server（8010）。形态 C 须 false。
hostCodeServerCompose:
  enabled: false
  image: linkagent-code-server:local
  host: 127.0.0.1
  port: 8010
  basePath: /vibe-ide
  # 本机已在 workspace 目录 npm install（含私服包）时设为 true；全容器 node 保持 false（默认）
  # useHostNodeModules: true
