# 复制为 node.env。已存在的环境变量优先于本文件。
LINKAGENT_GATEWAY_URL=ws://host.docker.internal:8787
# LINKAGENT_GATEWAY_TOKEN=nt_xxxxxxxx
# LINKAGENT_NODE_CLAIM=nu_xxxxxxxx
# LINKAGENT_NODE_NAME=builder-01
LINKAGENT_NODE_AGENTS=pi
# ARK_API_KEY=
# 不填则用 LINKAGENT_GATEWAY_TOKEN（nt_）。node 写入 /etc/linkagent/frpc.toml，容器入口启动 frpc。
# FRPS_TOKEN=
# frpc 连 frps 的控制口，缺省 7000。
# FRPS_SERVER_ADDR=host.docker.internal
# FRPS_SERVER_PORT=7000
# 浏览器访问这两条 HTTP 的端口是 frps vhostHTTPPort，缺省 7080。
# LINKAGENT_IDE_DOMAIN=ide.localhost:7080
# LINKAGENT_DEV_DOMAIN=dev.localhost:7080
# LINKAGENT_VNC_DOMAIN=vnc.localhost:7080
# 宿主机任务根。node 只挂载 <workspace>/<用户>，容器内工作目录是 /root/workspace。
# LINKAGENT_WORKSPACE=D:/work/workspace
LINKAGENT_NODE_USER=local
# LINKAGENT_NODE_IMAGE=linkagent-node:local
# 宿主机 agent 配置，缺省是用户目录下的 .pi，挂到容器 /root/.pi。
# LINKAGENT_AGENT_HOME=C:/Users/you/.pi
