# SaaS 执行机：Docker 形态 C（§4.2 docs/edge-apisix-node.md）
# 复制为 <安装根>/.runtime-state/node.env（见 config/node.env.example），勿与 PM 原生 node 同时运行。
# 可选 code-server/node-docker/node.env 只写 WORKSPACE / NODE_USER。
#
# 网关机升级：在服务器源码目录 git pull 后 bash scripts/server-install-update.sh --restart
#
# 若 hubide 443 未反代 /api/nodes/ws，改用网关机公网 IP:8787（安全组放行 8787、7000）
LINKAGENT_GATEWAY_URL=ws://150.5.142.161:8787
# LINKAGENT_GATEWAY_URL=wss://hubide.ljyd.cn
LINKAGENT_GATEWAY_TOKEN=nt_xxxxxxxx
# 审批模式可改用 LINKAGENT_NODE_CLAIM=nu_xxxxxxxx（与 nt_ 二选一）
#
FRPS_SERVER_ADDR=150.5.142.161
FRPS_SERVER_PORT=7000
FRPS_TOKEN=<与网关机 .runtime-state/edge/frps.token 相同，不是 nt_>
#
LINKAGENT_PUBLIC_HOST=hubide.ljyd.cn
LINKAGENT_NODE_SERVE_WEB=0
LINKAGENT_NODE_AGENTS=pi,opencode,workbuddy,trace-cli,cursor,hermes
LINKAGENT_NODE_USER=local
LINKAGENT_WORKSPACE=D:/yxz/projects/agent-linker/.runtime-state/tasks-workspace
# LINKAGENT_AGENT_HOME=C:/Users/you/.pi
